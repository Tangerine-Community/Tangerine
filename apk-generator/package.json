{
  "name": "apk-generator",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "info": "./src/scripts/info.sh",
    "release-online-survey-app": "./src/scripts/release-online-survey-app.sh",
    "release-apk": "./src/scripts/release-apk.sh",
    "release-pwa": "./src/scripts/release-pwa.sh"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "overrides": {
    "semver": "^7.6.3",
    "send": "^0.19.0",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.5",
    "word-wrap": "^1.2.5",
    "qs": "^6.13.1",
    "braces": "^3.0.3",
    "picomatch": "^2.3.2",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.2",
    "minimatch": "^3.1.4",
    "path-to-regexp": "0.1.13",
    "lodash": "^4.17.21",
    "body-parser": "^1.20.3",
    "multer": "^1.4.5-lts.2",
    "form-data": "^4.0.6",
    "ngrok": "^5.0.0-beta.2"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cordova-hot-code-push-cli": "github:Tangerine-Community/cordova-hot-code-push-cli",
    "cors": "^2.8.5",
    "express-http-proxy": "^1.6.3",
    "@nestjs/common": "9.3.2",
    "@nestjs/core": "9.3.2",
    "@nestjs/platform-express": "9.3.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "sanitize-filename": "^1.6.3",
    "tangy-log": "^1.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.2.0",
    "@nestjs/schematics": "^9.0.4",
    "@nestjs/testing": "9.3.2",
    "@types/express": "^4.17.13",
    "@types/jest": "29.2.4",
    "@types/node": "18.11.18",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "semver": "^7.6.3",
    "send": "^0.19.0",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.5",
    "word-wrap": "^1.2.5",
    "qs": "^6.13.1"
  }
}
